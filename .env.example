# Postgres (matches docker-compose.yml)
POSTGRES_USER=tracker
POSTGRES_PASSWORD=tracker
POSTGRES_DB=financial_tracker
DATABASE_URL=postgres://tracker:tracker@localhost:5432/financial_tracker
TEST_DATABASE_URL=postgres://tracker:tracker@localhost:5432/financial_tracker_test

# API
API_PORT=4000
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
COOKIE_SECURE=false

# MCP server
MCP_PORT=4100
MCP_URL=http://localhost:4100/mcp
MCP_INTERNAL_SECRET=change-me-internal-secret-at-least-32-chars

# LLM: "fake" works offline (scripted); set "anthropic" + ANTHROPIC_API_KEY for real Claude
LLM_PROVIDER=fake
LLM_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=

# Web
API_INTERNAL_URL=http://localhost:4000
LOG_LEVEL=info
